# PiVista TV — product configuration
# Single source of truth for product identity and image geometry.
# Changing the product name here updates the image, UI, service and docs.

PIVISTA_NAME="PiVista TV"
PIVISTA_SLUG="pivista-tv"
PIVISTA_VERSION="0.3.1"
PIVISTA_CODENAME="Cascade"
PIVISTA_VENDOR="The PiVista Project"
PIVISTA_TAGLINE="Television, without the computer"

# Unprivileged account that owns the graphical session and the launcher.
PIVISTA_USER="pivista"
PIVISTA_GROUP="pivista"
PIVISTA_HOME="/home/pivista"
PIVISTA_UID="1000"
PIVISTA_GID="1000"

# Installed locations (FHS).
PIVISTA_PREFIX="/usr/share/pivista"
PIVISTA_LAUNCHER="/usr/bin/pivista-launcher"
PIVISTA_DAEMON="/usr/lib/pivista/pivistad.py"
PIVISTA_CONFIG="/etc/pivista"
PIVISTA_STATE="/var/lib/pivista"
PIVISTA_RUNTIME="/run/pivista"

# Target hardware.
PIVISTA_MODEL="Raspberry Pi 5"
PIVISTA_SOC="BCM2712"
PIVISTA_ARCH="arm64"

# Image geometry (must match manifest/image-config.yaml).
PIVISTA_ROOT_PART_GB="7"
PIVISTA_BOOT_PART_MB="512"

# Build host defaults.
PIVISTA_WORKDIR_DEFAULT="/var/tmp/pivista-build"
PIVISTA_JOBS_DEFAULT="2"
