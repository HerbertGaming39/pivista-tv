# PAM stack for the PiVista TV kiosk session.
# There is no interactive login: systemd starts the session as the pivista
# account. pam_systemd registers it with logind so the compositor can take the
# DRM seat and VT.
auth required pam_permit.so
account required pam_permit.so
password required pam_permit.so
session required pam_systemd.so
session required pam_limits.so
session optional pam_loginuid.so
